# Formulaire de contact (/contact) — à définir en local (.env.local) ET sur Vercel.

# Resend — envoi de l'email vers contact@kinaya.wtf
RESEND_API_KEY=
# Optionnel : expéditeur (doit appartenir à un domaine vérifié dans Resend).
# Défaut : "Kinaya <contact@kinaya.wtf>"
CONTACT_FROM=

# Notion — création d'une page à chaque soumission
NOTION_API_KEY=
NOTION_DATABASE_ID=
